  "facts": [
    { "fact_id": "F-001", "text": "Boyd Reems reports three Crane relatives missing from the Sawyer Ridge farm: Verna, Dale, and Cody Crane.", "reliability": "TESTIMONY", "tags": ["boyd", "verna", "dale", "cody", "ridge_farm"], "conditions": ["secondhand", "reporter is agitated"] },
    { "fact_id": "F-002", "text": "Wade Crane phoned the sheriff twice — first to ask for a welfare check on his grandmother Verna, then to cancel it hours later.", "reliability": "DOCUMENT", "tags": ["wade", "verna", "ridge_farm"] },
    { "fact_id": "F-003", "text": "Sawyer Ridge (40 acres) belonged to Wade's late grandfather, Ottis Crane.", "reliability": "DOCUMENT", "tags": ["ottis", "ridge_farm", "wade"] },
    { "fact_id": "F-004", "text": "A deputy's first pass found the farmhouse locked, half-packed with trip gear, and Dale's truck gone; he figured the family had left for deer camp.", "reliability": "TESTIMONY", "tags": ["ridge_farm", "dale_truck"], "conditions": ["scene appeared to be a trip in progress", "no bodies present", "went off what Wade had told dispatch"] },
    { "fact_id": "F-005", "text": "There are grounds for a warrant to search the Sawyer Ridge house.", "reliability": "DOCUMENT", "tags": ["ridge_farm"] },

    { "fact_id": "F-007", "text": "Amos Pike, who runs the rural mail route, says he saw the Cranes loading up and heading off for deer camp around the 18th.", "reliability": "TESTIMONY", "tags": ["amos", "ridge_farm", "dale_truck", "t_oct18", "t_dusk"], "conditions": ["at dusk", "across the bottom field, ~300 yards", "assumed it was the annual deer camp"] },

    { "fact_id": "F-010", "text": "Three spent .30-30 rifle casings and a live round lie on the kitchen floor.", "reliability": "FORENSIC", "tags": ["ridge_farm", "casings_3030"] },
    { "fact_id": "F-011", "text": "Luminol reveals high-velocity blood spatter under the fresh paint, across the whole kitchen.", "reliability": "FORENSIC", "tags": ["ridge_farm", "fresh_paint", "bleach"] },
    { "fact_id": "F-012", "text": "Furniture was moved and the kitchen floor scrubbed with bleach and repainted to bury the spatter.", "reliability": "FORENSIC", "tags": ["ridge_farm", "fresh_paint", "bleach"] },

    { "fact_id": "F-020", "text": "A burned, overturned pickup sits in Kettle Hollow, a quarter mile from the house, holding three badly burned bodies.", "reliability": "FORENSIC", "tags": ["kettle_hollow", "dale_truck"] },
    { "fact_id": "F-021", "text": "Boot prints, drag marks, and tractor-tire tracks run from the barn down to the burned truck.", "reliability": "FORENSIC", "tags": ["kettle_hollow", "ridge_farm"] },
    { "fact_id": "F-022", "text": "The truck was covered with brush, a canvas tarp, and a log-chain before it was set alight.", "reliability": "FORENSIC", "tags": ["kettle_hollow", "log_chain", "dale_truck"] },
    { "fact_id": "F-023", "text": "The fire was set at dawn on the 22nd, only hours before it was spotted.", "reliability": "FORENSIC", "tags": ["kettle_hollow", "t_oct22", "t_dawn"] },
    { "fact_id": "F-024", "text": "The medical examiner identifies the three burned victims as Verna, Dale, and Cody Crane.", "reliability": "FORENSIC", "tags": ["verna", "dale", "cody"] },
    { "fact_id": "F-025", "text": "At least one victim was shot; all three were likely incapacitated before the fire was set.", "reliability": "FORENSIC", "tags": ["casings_3030", "kettle_hollow"] },

    { "fact_id": "F-030", "text": "Records show Wade Crane returned to Marrow County last spring after years working offshore.", "reliability": "DOCUMENT", "tags": ["wade", "t_spring"] },
    { "fact_id": "F-031", "text": "Wade has a protective-order and assault file from his ex, Kayla Dorn, down in Louisiana.", "reliability": "DOCUMENT", "tags": ["wade", "kayla", "dv_file"] },
    { "fact_id": "F-033", "text": "Wade had filed a nuisance complaint claiming Dale was selling off Ottis's guns and timber with no right.", "reliability": "DOCUMENT", "tags": ["wade", "dale", "ottis", "nuisance_report", "ottis_guns"] },

    { "fact_id": "F-040", "text": "Boyd warns Wade is a liar, was seen at the farm packed and armed, left word the relatives had 'gone off,' and was raised on Ottis's guns.", "reliability": "TESTIMONY", "tags": ["wade", "boyd", "ridge_farm", "ottis_guns"], "conditions": ["Boyd is afraid of Wade"] },
    { "fact_id": "F-041", "text": "Wade produced a note — 'Gone to your aunt's in Arkansas. —Dale' — but the hand isn't Dale's; Wade wrote it himself.", "reliability": "DOCUMENT", "tags": ["wade", "dale", "arkansas_note"] },
    { "fact_id": "F-043", "text": "Lorraine names Rhonda Sisk — Wade's half-sister — as the one who's been with Wade and likely helping him.", "reliability": "TESTIMONY", "tags": ["rhonda", "wade", "lorraine"] },

    { "fact_id": "F-050", "text": "Rhonda claims she only reconnected with Wade recently and barely knew the family.", "reliability": "TESTIMONY", "tags": ["rhonda", "wade", "t_spring"], "conditions": ["self-serving", "keeps asking to leave"] },
    { "fact_id": "F-051", "text": "Rhonda insists Ottis's green Bronco doesn't run and she has no idea who'd have driven it.", "reliability": "TESTIMONY", "tags": ["rhonda", "green_bronco"], "conditions": ["self-serving"] },
    { "fact_id": "F-052", "text": "Rhonda accuses Boyd of threatening them and being behind the disappearances.", "reliability": "TESTIMONY", "tags": ["rhonda", "boyd"], "conditions": ["deflecting"] },
    { "fact_id": "F-053", "text": "Rhonda refers to the relatives as dead — and to Wade maybe having done it — before police have told her anyone died.", "reliability": "TESTIMONY", "tags": ["rhonda", "wade"], "conditions": ["slip — knowledge she should not have"] },

    { "fact_id": "F-060", "text": "Cutter's Mill neighbors say a long-haired man had been living with Rhonda and driving Ottis's green Bronco, often parked out front.", "reliability": "TESTIMONY", "tags": ["rhonda", "green_bronco", "wade"], "conditions": ["from a distance", "matches Wade's description"] },
    { "fact_id": "F-062", "text": "An old Polaroid and a pawn ticket in Wade's name put Wade and Rhonda together years before she claims they met.", "reliability": "DOCUMENT", "tags": ["wade", "rhonda", "polaroid", "pawn_ticket"] },
    { "fact_id": "F-063", "text": "The Kettle Creek General Store clerk and a receipt put Wade and Rhonda buying bleach, floor paint, and kerosene together that week.", "reliability": "DOCUMENT", "tags": ["wade", "rhonda", "general_store", "bleach", "kerosene"] },

    { "fact_id": "F-071", "text": "Rhonda's cellar holds dustless totes and duffels, papers belonging to a victim, Ottis's deed, and a box of .30-30 shells.", "reliability": "FORENSIC", "tags": ["rhonda_place", "deed", "casings_3030"] },

    { "fact_id": "F-080", "text": "Phone-company toll records and a motel register place Rhonda 600 miles away at the Blue Spruce Motor Lodge in Oklahoma.", "reliability": "DOCUMENT", "tags": ["rhonda", "blue_spruce", "phone_co", "motel_register"] },
    { "fact_id": "F-081", "text": "Toll records show a burst of calls between Wade's and Rhonda's lines on the 18th, around dusk.", "reliability": "DOCUMENT", "tags": ["wade", "rhonda", "toll_records", "t_oct18", "t_dusk"] },

    { "fact_id": "F-090", "text": "There are no casings or bullet damage at Boyd's place, and a dozen witnesses put him at the county stockyard auction all that day.", "reliability": "FORENSIC", "tags": ["boyd", "boyd_farm", "stockyard"] },

    { "fact_id": "F-100", "text": "The green Bronco, recovered in Oklahoma, holds a rifle case, .30-30 shells, empty gas cans, and Wade's discharge papers and wallet.", "reliability": "FORENSIC", "tags": ["green_bronco", "rifle_case", "casings_3030", "gas_cans", "discharge_papers", "wade"] },

    { "fact_id": "F-110", "text": "Wade claims Boyd fired on him at the farm on the 21st, driving him into hiding.", "reliability": "TESTIMONY", "tags": ["wade", "boyd", "t_oct21"], "conditions": ["unverified", "overly detailed"] },
    { "fact_id": "F-111", "text": "Wade admits he 'messed up the scene' and hid the bodies, but claims Dale and Cody shot each other.", "reliability": "TESTIMONY", "tags": ["wade", "dale", "cody"], "conditions": ["partial admission", "self-exculpating"] },
    { "fact_id": "F-112", "text": "Wade describes covering and burning the truck at dawn on the 22nd, calling it 'giving them a pyre.'", "reliability": "TESTIMONY", "tags": ["wade", "kettle_hollow", "dale_truck", "t_oct22", "t_dawn"] },

    { "fact_id": "F-120", "text": "Rhonda admits Wade went into the house alone, then had her help scrub and paint the floor and move furniture.", "reliability": "TESTIMONY", "tags": ["rhonda", "wade", "ridge_farm"], "conditions": ["confession"] },
    { "fact_id": "F-121", "text": "Rhonda describes loading the bodies into Dale's truck — a log-chain and the tractor to drag Cody — then driving to the hollow and tipping it.", "reliability": "TESTIMONY", "tags": ["rhonda", "wade", "dale_truck", "log_chain", "kettle_hollow", "cody"] },
    { "fact_id": "F-122", "text": "Rhonda admits helping clean up but insists Wade told her the family was already dead when he found them.", "reliability": "TESTIMONY", "tags": ["rhonda", "wade"], "conditions": ["minimizes her role"] },

    { "fact_id": "F-130", "text": "Probate records show Ottis's 40 acres willed to Dale's household; Wade came home insisting the ridge was rightfully his.", "reliability": "DOCUMENT", "tags": ["wade", "ottis", "deed", "ridge_farm"] }
  ],

  "contradictions": [
    { "contradiction_id": "C-01", "facts": ["F-007", "F-011"], "resolution_actions": ["A-12"], "_note": "'Family left for deer camp' vs. blood spatter under fresh paint." },
    { "contradiction_id": "C-02", "facts": ["F-050", "F-062"], "resolution_actions": ["A-05"], "_note": "'Only just met Wade' vs. a years-old Polaroid and pawn ticket." },
    { "contradiction_id": "C-03", "facts": ["F-051", "F-060"], "resolution_actions": ["A-40"], "_note": "'Green Bronco won't run / don't know who drove it' vs. neighbors seeing Wade drive it." },
